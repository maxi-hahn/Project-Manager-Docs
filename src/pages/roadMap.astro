---
import BaseLayout from "../layouts/BaseLayout.astro";
import { config } from "../config";

interface RoadmapItem {
  title: string;
  description?: string;
  status: "done" | "next" | "planned" | "someday";
}

const groups: { label: string; items: RoadmapItem[] }[] = [
  {
    label: "Próximo",
    items: [
      { title: "Features para TypeScript (React Router, Axios, i18n)", status: "next" },
      { title: "Template Next.js", status: "next" },
    ],
  },
  {
    label: "Planeado",
    items: [
      { title: "Template Node Express", status: "planned" },
      { title: "Template Vue", status: "planned" },
      { title: "Features para C#", status: "planned" },
      { title: "Sistema de variantes completo", status: "planned" },
    ],
  },
  {
    label: "Algún día",
    items: [
      { title: "Traducción a inglés (GUI + READMEs)", status: "someday" },
      { title: "Contribuciones externas de templates", status: "someday" },
    ],
  },
];

const badgeColor: Record<RoadmapItem["status"], string> = {
  done: "bg-green-500/10 text-green-400 border-green-500/20",
  next: "bg-accent/10 text-accent border-accent/20",
  planned: "bg-neutral-500/10 text-neutral-400 border-neutral-500/20",
  someday: "bg-neutral-500/10 text-neutral-500 border-neutral-500/20",
};
---

<BaseLayout title="Roadmap" description="Qué viene en Project Manager.">
  <section class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="text-3xl font-bold text-white">Roadmap</h1>
    <p class="mt-2 max-w-3xl text-neutral-400">
      Plan de features y templates para {config.name}. El orden puede cambiar
      según feedback y prioridades.
    </p>
  </section>

  {groups.map((group) => (
    <section class="mx-auto max-w-5xl border-t border-border px-6 py-12">
      <h2 class="text-xl font-semibold text-white">{group.label}</h2>
      <ul class="mt-6 flex flex-col gap-3">
        {group.items.map((item) => (
          <li class="rounded-lg border border-border bg-card p-4">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-medium text-white">{item.title}</p>
                {item.description && (
                  <p class="mt-1 text-sm text-neutral-400">{item.description}</p>
                )}
              </div>
              <span class={`shrink-0 rounded-full border px-2.5 py-0.5 text-xs font-medium ${badgeColor[item.status]}`}>
                {group.label}
              </span>
            </div>
          </li>
        ))}
      </ul>
    </section>
    <section class="mx-auto max-w-5xl border-t border-border px-6 py-12">
  <h2 class="text-xl font-semibold text-white">¿Querés ayudar con algo de esto?</h2>
  <p class="mt-2 text-neutral-400">
    Cualquiera puede contribuir. Mirá cómo en la página de colaboración.
  </p>
  <a
    href="/colaborar"
    class="mt-6 inline-block rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90"
  >
    Cómo colaborar →
  </a>
</section>
  ))}
</BaseLayout>