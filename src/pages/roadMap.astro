---
import BaseLayout from "../layouts/BaseLayout.astro";
import { config } from "../config";

interface RoadmapItem {
  title: string;
  description?: string;
  status: "done" | "next" | "planned" | "someday";
}

const groups: { label: string; items: RoadmapItem[] }[] = [
  {
    label: "Próximo",
    items: [
      { title: "Features para TypeScript (React Router, Axios, i18n)", status: "next" },
      { title: "Template Next.js (Web App)", status: "next" },
      { title: "Template Vue.js + Vite (Web App)", status: "next" },
      { title: "Template Node.js + Express (Web API)", status: "next" },
    ],
  },
  {
    label: "Planeado",
    items: [
      { title: "Features para C#", status: "planned" },
      { title: "Sistema de variantes completo", status: "planned" },
      { title: "Template C# Blazor (Web App)", status: "planned" },
      { title: "Template Python CLI Avanzado (Typer/Click)", status: "planned" },
      { title: "Template Python Data Science (Jupyter/Pandas)", status: "planned" },
      { title: "Template Go REST API", status: "planned" },
      { title: "Template Rust CLI", status: "planned" },
      { title: "Tool Vitest (JS)", status: "planned" },
      { title: "Tool Jest (JS)", status: "planned" },
      { title: "Tool Husky + lint-staged (JS)", status: "planned" },
      { title: "Tool Black (Python)", status: "planned" },
      { title: "Tool MyPy (Python)", status: "planned" },
      { title: "Tool xUnit (C#)", status: "planned" },
      { title: "Tool StyleCop (C#)", status: "planned" },
      { title: "Feature Authentication / JWT (Python)", status: "planned" },
      { title: "Feature Authentication / JWT (React)", status: "planned" },
      { title: "Feature File Upload (Python)", status: "planned" },
      { title: "Feature File Upload (React)", status: "planned" },
      { title: "Feature React Query / Data Fetching (JS)", status: "planned" },
      { title: "Feature Zustand / State Management (JS)", status: "planned" },
      { title: "Feature React Hook Form (JS)", status: "planned" },
      { title: "Feature Serilog (C#)", status: "planned" },
      { title: "Feature FluentValidation (C#)", status: "planned" },
      { title: "Environment Docker (C#)", status: "planned" },
      { title: "Environment Kubernetes (K8s)", status: "planned" },
      { title: "Environment Nginx (Reverse Proxy)", status: "planned" },
      { title: "Technology PostgreSQL + Alembic (Python)", status: "planned" },
      { title: "Technology MongoDB (Python/JS)", status: "planned" },
      { title: "Technology Redis (Python/JS)", status: "planned" },
      { title: "Technology Celery (Python)", status: "planned" },
      { title: "Technology Entity Framework Core (C#)", status: "planned" },
      { title: "Technology Material UI (React)", status: "planned" },
      { title: "Technology Bootstrap (React)", status: "planned" },
      { title: "Technology Chakra UI (React)", status: "planned" },
    ],
  },
  {
    label: "Algún día",
    items: [
      { title: "Traducción a inglés (GUI + READMEs)", status: "someday" },
      { title: "Contribuciones externas de templates", status: "someday" },
    ],
  },
];

const badgeColor: Record<RoadmapItem["status"], string> = {
  done: "bg-green-500/10 text-green-400 border-green-500/20",
  next: "bg-accent/10 text-accent border-accent/20",
  planned: "bg-neutral-500/10 text-neutral-400 border-neutral-500/20",
  someday: "bg-neutral-500/10 text-neutral-500 border-neutral-500/20",
};
---

<BaseLayout title="Roadmap" description="Qué viene en Project Manager.">
  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-16">
    <h1 class="text-2xl font-bold text-white sm:text-3xl">Roadmap</h1>
    <p class="mt-2 max-w-3xl text-sm text-neutral-400 sm:text-base">
      Plan de features y templates para {config.name}. El orden puede cambiar
      según feedback y prioridades.
    </p>
  </section>

  {groups.map((group) => (
    <section class="mx-auto max-w-5xl border-t border-border px-4 py-8 sm:px-6 sm:py-12">
      <h2 class="text-lg font-semibold text-white sm:text-xl">{group.label}</h2>
      <ul class="mt-6 flex flex-col gap-3">
        {group.items.map((item) => (
          <li class="rounded-lg border border-border bg-card p-4">
            <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-start sm:gap-4">
              <div>
                <p class="font-medium text-white">{item.title}</p>
                {item.description && (
                  <p class="mt-1 text-sm text-neutral-400">{item.description}</p>
                )}
              </div>
              <span class={`self-start shrink-0 rounded-full border px-2.5 py-0.5 text-xs font-medium sm:self-auto ${badgeColor[item.status]}`}>
                {group.label}
              </span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="mx-auto max-w-5xl border-t border-border px-4 py-8 sm:px-6 sm:py-12">
    <h2 class="text-lg font-semibold text-white sm:text-xl">¿Querés ayudar con algo de esto?</h2>
    <p class="mt-2 text-sm text-neutral-400 sm:text-base">
      Cualquiera puede contribuir. Mirá cómo en la página de colaboración.
    </p>
    <a
      href="/colaborar"
      class="mt-6 inline-block w-full rounded-md bg-accent px-5 py-2.5 text-center text-sm font-medium text-white transition-opacity hover:opacity-90 sm:w-auto"
    >
      Cómo colaborar →
    </a>
  </section>
</BaseLayout>
