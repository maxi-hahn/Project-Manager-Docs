---
interface Props {
  id?: string;
  title: string;
  content?: string;
}

const { id, title, content } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl border-t border-border px-4 py-8 sm:px-6 sm:py-16">
  <h2 class="text-xl font-semibold text-white sm:text-2xl">{title}</h2>
  {content && <p class="mt-3 max-w-3xl text-sm text-neutral-400 sm:mt-4 sm:text-base">{content}</p>}
  <div class="mt-6">
    <slot />
  </div>
</section>
