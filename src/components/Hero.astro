---
import { config, getLatestVersion, getDownloadUrl } from "../config";

const version = await getLatestVersion();
const badge = config.hero.badge?.replace(/v[\d.]+/, `v${version}`) ?? `v${version}`;
const downloadUrl = await getDownloadUrl();
---

<section class="mx-auto max-w-5xl px-6 py-24">
  <div class="flex flex-col items-start gap-6">
    <span class="rounded-full border border-border bg-card px-3 py-1 text-xs font-mono text-neutral-400">
      {badge}
    </span>
    <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
      {config.hero.title}
    </h1>
    <p class="max-w-2xl text-lg text-neutral-400">
      {config.hero.subtitle}
    </p>
    <div class="flex flex-wrap gap-3 pt-2">
      <button
        type="button"
        data-open-download-modal
        data-download-url={downloadUrl}
        class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90"
      >
        {config.hero.primaryCta.label}
      </button>
      {config.hero.secondaryCta && (
        <a
          href={config.hero.secondaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md border border-border bg-card px-5 py-2.5 text-sm font-medium text-neutral-300 transition-colors hover:text-white"
        >
          {config.hero.secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</section>