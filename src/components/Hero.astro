---
import { config, getLatestVersion, getDownloadUrl } from "../config";

const version = await getLatestVersion();
const badge = config.hero.badge?.replace(/v[\d.]+/, `v${version}`) ?? `v${version}`;
const downloadUrl = await getDownloadUrl();
---

<section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-20 md:py-24">
  <div class="flex flex-col items-start gap-4 sm:gap-6">
    <span class="rounded-full border border-border bg-card px-3 py-1 text-xs font-mono text-neutral-400">
      {badge}
    </span>
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-5xl">
      {config.hero.title}
    </h1>
    <p class="max-w-2xl text-base text-neutral-400 sm:text-lg">
      {config.hero.subtitle}
    </p>
    <div class="flex w-full flex-col gap-3 pt-2 sm:w-auto sm:flex-row sm:flex-wrap">
      <button
        type="button"
        data-open-download-modal
        data-download-url={downloadUrl}
        class="w-full rounded-md bg-accent px-5 py-2.5 text-center text-sm font-medium text-white transition-opacity hover:opacity-90 sm:w-auto"
      >
        {config.hero.primaryCta.label}
      </button>
      {config.hero.secondaryCta && (
        <a
          href={config.hero.secondaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full rounded-md border border-border bg-card px-5 py-2.5 text-center text-sm font-medium text-neutral-300 transition-colors hover:text-white sm:w-auto"
        >
          {config.hero.secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</section>
