---
import { config } from "../config";

const { notify } = config;
---

{notify.enabled && (
  <div class="rounded-lg border border-border bg-card p-4 sm:p-6">
    <h3 class="text-base font-semibold text-white sm:text-lg">{notify.title}</h3>
    <p class="mt-1 text-sm text-neutral-400">{notify.description}</p>

    <form id="notify-form" class="mt-5 flex flex-col gap-4">
      <label class="flex cursor-pointer items-start gap-3 text-sm text-neutral-300 sm:items-center">
        <input
          type="checkbox"
          id="notify-checkbox"
          class="mt-0.5 h-4 w-4 shrink-0 cursor-pointer rounded border-border bg-bg accent-accent sm:mt-0"
        />
        <span>{notify.checkboxLabel}</span>
      </label>

      <div id="notify-email-wrapper" class="hidden flex-col gap-3 sm:flex-row">
        <input
          type="email"
          id="notify-email"
          placeholder={notify.emailPlaceholder}
          required
          class="w-full rounded-md border border-border bg-bg px-3 py-2.5 text-sm text-white placeholder-neutral-500 outline-none focus:border-accent sm:flex-1 sm:py-2"
        />
        <button
          type="submit"
          class="w-full rounded-md bg-accent px-5 py-2.5 text-center text-sm font-medium text-white transition-opacity hover:opacity-90 sm:w-auto sm:py-2"
        >
          {notify.submitLabel}
        </button>
      </div>

      <p id="notify-message" class="hidden text-sm"></p>
    </form>
  </div>
)}

<script define:vars={{ endpoint: notify.endpoint, successMessage: notify.successMessage, errorMessage: notify.errorMessage }}>
  const checkbox = document.getElementById("notify-checkbox");
  const wrapper = document.getElementById("notify-email-wrapper");
  const form = document.getElementById("notify-form");
  const message = document.getElementById("notify-message");

  checkbox?.addEventListener("change", () => {
    wrapper?.classList.toggle("hidden", !checkbox.checked);
    wrapper?.classList.toggle("flex", checkbox.checked);
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!message) return;
    
    const email = document.getElementById("notify-email")?.value;
    
    if (!email || !endpoint) {
      message.textContent = errorMessage;
      message.className = "text-sm text-red-400";
      return;
    }

    try {
      // 1. Creamos el iframe oculto si no existe
      let iframe = document.getElementById("hidden_iframe");
      if (!iframe) {
        iframe = document.createElement("iframe");
        iframe.name = "hidden_iframe";
        iframe.id = "hidden_iframe";
        iframe.style.display = "none";
        document.body.appendChild(iframe);
      }

      // 2. Creamos el formulario clásico
      const hiddenForm = document.createElement("form");
      hiddenForm.method = "POST";
      hiddenForm.action = endpoint;
      hiddenForm.target = "hidden_iframe";
      hiddenForm.style.display = "none";

      // 3. Agregamos el email
      const input = document.createElement("input");
      input.type = "hidden";
      input.name = "email";
      input.value = email;
      hiddenForm.appendChild(input);

      document.body.appendChild(hiddenForm);
      hiddenForm.submit();
      
      // 4. Esperamos a que viaje
      await new Promise(r => setTimeout(r, 800));

      // 5. Mostramos mensaje de éxito
      message.textContent = successMessage;
      message.className = "text-sm text-green-400";
      form.reset();
      wrapper?.classList.add("hidden");
      wrapper?.classList.remove("flex");
    } catch {
      message.textContent = errorMessage;
      message.className = "text-sm text-red-400";
    }
  });
</script>
