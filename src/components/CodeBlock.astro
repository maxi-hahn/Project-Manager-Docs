---
interface Props {
  label?: string;
  code: string;
}

const { label, code } = Astro.props;
---

<div class="w-full max-w-full overflow-hidden rounded-lg border border-border bg-card">
  {label && (
    <div class="border-b border-border px-3 py-2 text-xs font-medium text-neutral-500 sm:px-4">
      {label}
    </div>
  )}
  <pre class="overflow-x-auto p-3 text-xs sm:p-4 sm:text-sm"><code class="font-mono text-neutral-300">{code}</code></pre>
</div>
